# LedgerLeaf Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Secret key for session signing and CSRF protection.
# Change this in production to a random 32+ character string.
LEDGERLEAF_SECRET_KEY=change-me-in-production

# URL of the frontend application. Used for CORS and API references.
LEDGERLEAF_APP_ORIGIN=http://localhost:5173

# Database URL. SQLite is used by default; point to a file outside the repo.
LEDGERLEAF_DATABASE_URL=sqlite:///path/to/data/ledgerleaf.db

# Directory for uploaded documents (invoices, receipts, etc.).
# Must be outside the public frontend asset directory.
LEDGERLEAF_DOCUMENTS_DIR=path/to/documents

# API server settings (used by the backend server, not the frontend).
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=true
